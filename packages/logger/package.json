{
  "name": "@rokke/logger",
  "version": "0.1.0-alpha.1",
  "description": "High-performance structured logging with pluggable transports for Rokke framework on Bun",
  "type": "module",
  "main": "./index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "bunx tsc -b",
    "prepublishOnly": "bunx tsc -b"
  },
  "author": "Fernando Duarte <ferchd@rokke.dev>",
  "license": "MIT",
  "homepage": "https://rokke.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokke-dev/framework.git",
    "directory": "packages/logger"
  },
  "bugs": {
    "url": "https://github.com/rokke-dev/framework/issues"
  },
  "keywords": [
    "bun",
    "framework",
    "logger",
    "logging",
    "structured-logging",
    "transports"
  ],
  "dependencies": {
    "@rokke/core": "workspace:*",
    "@rokke/config": "workspace:*",
    "@rokke/fs": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
